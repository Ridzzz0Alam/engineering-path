---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCourses } from '../lib/content';

const courses = [...(await getCourses()).values()];
const index = Object.fromEntries(
  courses.flatMap((c) => c.lessons.map((l) => [l.id, { title: l.title, url: l.url, course: c.config.title }])),
);
---

<BaseLayout title="My notes">
  <section class="container notes-page">
    <span class="eyebrow">My notes</span>
    <h1>Everything you've written</h1>
    <p class="muted">Notes are stored in this browser only. Export them to keep a copy or move them to another device.</p>
    <div class="actions">
      <button class="btn btn-primary" type="button" data-export>Download as Markdown</button>
    </div>
    <div data-notes-list class="list"></div>
    <p class="empty muted" data-empty hidden>No notes yet. Open any lesson and use the “My notes” box at the bottom.</p>
  </section>

  <script define:vars={{ index }}>
    window.__LESSONS__ = index;
  </script>
  <script>
    import { allNotes } from '../scripts/progress';
    const index = (window as any).__LESSONS__ as Record<string, { title: string; url: string; course: string }>;
    const notes = allNotes().filter((n) => index[n.id]);
    const list = document.querySelector<HTMLElement>('[data-notes-list]')!;
    if (!notes.length) document.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
    for (const n of notes) {
      const meta = index[n.id];
      const card = document.createElement('article');
      card.className = 'card note';
      const small = document.createElement('small');
      small.textContent = meta.course;
      const h = document.createElement('h2');
      const a = document.createElement('a');
      a.href = meta.url;
      a.textContent = meta.title;
      h.appendChild(a);
      const p = document.createElement('p');
      p.textContent = n.text;
      card.append(small, h, p);
      list.appendChild(card);
    }
    document.querySelector('[data-export]')?.addEventListener('click', () => {
      const md = ['# My Engineering Path notes', ''].concat(
        notes.map((n) => `## ${index[n.id].title}\n_${index[n.id].course}_ · ${location.origin}${index[n.id].url}\n\n${n.text}\n`),
      ).join('\n');
      const blob = new Blob([md], { type: 'text/markdown' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'engineering-path-notes.md';
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>
</BaseLayout>

<style>
  .notes-page { max-width: 820px; padding: 48px 0 40px; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 12px 0 8px; }
  .actions { margin: 22px 0 28px; }
  .list { display: grid; gap: 14px; }
  .list :global(.note) { padding: 20px 22px; }
  .list :global(.note small) { color: var(--faint); font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: .06em; }
  .list :global(.note h2) { font-size: 1.2rem; margin: 6px 0 10px; }
  .list :global(.note h2 a) { text-decoration: none; }
  .list :global(.note p) { margin: 0; white-space: pre-wrap; color: var(--muted); }
</style>
