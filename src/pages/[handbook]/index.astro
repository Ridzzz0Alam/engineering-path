---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCourses, formatMinutes } from '../../lib/content';
import { HANDBOOKS } from '../../lib/handbooks';
import { SITE, SOURCE, LICENSE_URL } from '../../lib/site';

export function getStaticPaths() {
  return HANDBOOKS.map((h) => ({ params: { handbook: h.id } }));
}

const course = (await getCourses()).get(Astro.params.handbook!)!;
const { config, parts, lessons } = course;
const first = lessons[0];
const allIds = lessons.map((l) => l.id).join(',');
const partByFolder = new Map(parts.map((p) => [p.folder, p]));
const levels = (ls: typeof lessons) => {
  const c = { beginner: 0, intermediate: 0, advanced: 0 };
  ls.forEach((l) => c[l.difficulty]++);
  return c;
};
---

<BaseLayout title={`${config.title} course`} description={config.intro} course={config.id}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Free course · {lessons.length} lessons</span>
        <h1>{config.title}</h1>
        <p class="tagline">{config.tagline}</p>
        <p class="intro">{config.intro}</p>
        <div class="cta">
          <a class="btn btn-accent" href={first.url} data-continue={config.id} data-first={first.url}>
            <span data-cta-label>Start with lesson 1</span> →
          </a>
          <a class="btn btn-ghost" href="#curriculum">View curriculum</a>
        </div>
      </div>
      <aside class="card stats">
        <dl>
          <div><dt>Lessons</dt><dd>{lessons.length}</dd></div>
          <div><dt>Parts</dt><dd>{parts.length}</dd></div>
          <div><dt>Reading time</dt><dd>{formatMinutes(course.minutes)}</dd></div>
          <div><dt>Diagrams</dt><dd>{course.diagrams}</dd></div>
        </dl>
        <div class="stats-progress" data-progress={allIds}>
          <div class="row"><strong>Your progress</strong><small class="muted" data-progress-label>{lessons.length} lessons · not started</small></div>
          <div class="progress"><span></span></div>
        </div>
        <p class="stats-note">Free to read. No account needed. Progress stays in your browser.</p>
      </aside>
    </div>
  </section>

  <!-- Learning path -->
  <section class="section path-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Learning path</span>
          <h2>{config.stages.length} stages, one step at a time</h2>
          <p>Each stage builds on the one before it. Go in order the first time, then jump around when you need a refresher.</p>
        </div>
      </div>
      <ol class="stages">
        {config.stages.map((s, i) => {
          const sl = s.parts.flatMap((f) => partByFolder.get(f)?.lessons ?? []);
          return (
            <li class="stage">
              <span class="stage-num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.blurb}</p>
              <small class="muted">{sl.length} lessons · {formatMinutes(sl.reduce((a, l) => a + l.minutes, 0))}</small>
              <a class="stage-link" href={`#stage-${i + 1}`}>Jump to stage →</a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- Curriculum -->
  <section class="section curriculum" id="curriculum">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Curriculum</span>
          <h2>{parts.length} parts · {lessons.length} lessons</h2>
          <p>Open a part to see its lessons. Completed lessons are ticked off as you go.</p>
        </div>
        <button class="btn btn-ghost" type="button" data-expand-all>Expand all</button>
      </div>

      {config.stages.map((s, i) => (
        <div class="stage-block" id={`stage-${i + 1}`}>
          <h3 class="stage-title"><span class="mono">Stage {i + 1}</span> {s.name}</h3>
          <div class="parts">
            {s.parts.map((f) => partByFolder.get(f)).filter(Boolean).map((p) => {
              const lv = levels(p!.lessons);
              return (
                <details class="card part" id={p!.slug}>
                  <summary>
                    <span class="part-num mono">{p!.number !== null ? String(p!.number).padStart(2, '0') : '✦'}</span>
                    <span class="part-main">
                      <span class="part-title">{p!.title}</span>
                      <span class="part-summary">{p!.summary}</span>
                      <span class="part-meta">
                        <span>{p!.lessons.length} lessons</span>
                        <span>{formatMinutes(p!.minutes)}</span>
                        {lv.beginner > 0 && <span class="diff diff-beginner">{lv.beginner}</span>}
                        {lv.intermediate > 0 && <span class="diff diff-intermediate">{lv.intermediate}</span>}
                        {lv.advanced > 0 && <span class="diff diff-advanced">{lv.advanced}</span>}
                      </span>
                      <span class="part-progress" data-progress={p!.lessons.map((l) => l.id).join(',')}>
                        <span class="progress"><span></span></span>
                      </span>
                    </span>
                    <span class="chev" aria-hidden="true">⌄</span>
                  </summary>
                  <ol class="lesson-list">
                    {p!.lessons.map((l) => (
                      <li>
                        <a href={l.url} data-lesson-id={l.id}>
                          <span class="li-num mono">{String(l.indexInPart).padStart(2, '0')}</span>
                          <span class="li-body">
                            <span class="li-title">{l.title}</span>
                            {l.description && <span class="li-desc">{l.description}</span>}
                          </span>
                          <span class="li-meta">
                            <span class:list={['diff', `diff-${l.difficulty}`]} title={l.difficulty}></span>
                            <span class="mono">{l.minutes}m</span>
                            <span class="li-done" aria-label="Completed">✓</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              );
            })}
          </div>
        </div>
      ))}
      <p class="legend muted">
        <span class="diff diff-beginner">Beginner</span>
        <span class="diff diff-intermediate">Intermediate</span>
        <span class="diff diff-advanced">Advanced</span>
      </p>
    </div>
  </section>

  <!-- How to use -->
  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">How to get the most out of it</span><h2>Read, explain, revisit</h2></div></div>
      <div class="tips">
        <div class="card tip"><span class="mono">01</span><h3>Read in order first</h3><p>Lessons list their prerequisites at the top. The stages are ordered so you rarely meet a term before it's explained.</p></div>
        <div class="card tip"><span class="mono">02</span><h3>Write it in your own words</h3><p>Summarizing the idea and its trade-offs is the quickest way to find what you haven't understood yet.</p></div>
        <div class="card tip"><span class="mono">03</span><h3>Come back to the diagrams</h3><p>When revising, skim the diagrams and tables before re-reading. If you can explain each one, you know the lesson.</p></div>
      </div>
    </div>
  </section>

  <section class="container"><Newsletter /></section>

  <section class="container">
    <p class="course-credit">The lessons in this course are adapted from the <a href={`${SOURCE.repo}/tree/main/content/${config.id}`} target="_blank" rel="noopener">{config.title} handbook</a> in The Engineering Handbook by Handbook Academy and contributors, licensed under <a href={LICENSE_URL} target="_blank" rel="noopener">CC BY-SA 4.0</a>. The course structure, stage groupings and summaries on this page were written for {SITE.name}. <a href="/license/">Credits & license</a>.</p>
  </section>

  <script>
    import { refreshProgress, getLast } from '../../scripts/progress';
    refreshProgress();
    const cta = document.querySelector<HTMLAnchorElement>('[data-continue]');
    if (cta) {
      const last = getLast(cta.dataset.continue!);
      if (last && last !== cta.dataset.first) {
        cta.href = last;
        cta.querySelector('[data-cta-label]')!.textContent = 'Continue where you left off';
      }
    }
    const parts = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.part'));
    const btn = document.querySelector<HTMLButtonElement>('[data-expand-all]');
    btn?.addEventListener('click', () => {
      const open = !parts.every((p) => p.open);
      parts.forEach((p) => (p.open = open));
      btn.textContent = open ? 'Collapse all' : 'Expand all';
    });
    const hash = location.hash.slice(1);
    const target = hash && document.getElementById(hash);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
    }
  </script>
</BaseLayout>

<style>
  .hero { padding: clamp(56px, 8vw, 96px) 0 clamp(40px, 6vw, 72px); background:
      radial-gradient(800px 320px at 85% -10%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); margin: 16px 0 10px; letter-spacing: -0.035em; }
  .tagline { font-family: var(--font-head); font-size: clamp(1.15rem, 2.2vw, 1.45rem); color: var(--accent); margin: 0 0 18px; font-weight: 600; }
  .intro { color: var(--muted); font-size: 1.06rem; max-width: 58ch; line-height: 1.7; margin: 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .stats { padding: 32px; }
  .stats dl { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 0 0 22px; }
  .stats dt { font: 600 0.72rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .07em; color: var(--faint); }
  .stats dd { margin: 6px 0 0; font-family: var(--font-head); font-size: 1.8rem; font-weight: 700; letter-spacing: -0.02em; }
  .stats-progress { display: grid; gap: 8px; padding-top: 18px; border-top: 1px solid var(--border); }
  .stats-progress .row { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; font-size: 0.9rem; }
  .stats-note { font-size: 0.82rem; color: var(--faint); margin: 16px 0 0; }

  .path-section { padding-top: 72px; }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 24px; counter-reset: s; }
  .stage { position: relative; padding: 28px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); display: grid; gap: 8px; align-content: start; }
  .stage::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; border-radius: var(--radius) var(--radius) 0 0; background: var(--accent); opacity: .85; }
  .stage-num { color: var(--accent); font-weight: 700; font-size: 0.85rem; }
  .stage h3 { font-size: 1.12rem; }
  .stage p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
  .stage-link { font-size: 0.85rem; color: var(--accent); text-decoration: none; font-weight: 600; margin-top: 4px; }

  .curriculum { padding-top: 32px; }
  .stage-block + .stage-block { margin-top: 64px; }
  .stage-title { font-size: 1.25rem; margin-bottom: 20px; display: flex; gap: 12px; align-items: baseline; }
  .stage-title .mono { font-size: 0.78rem; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; }
  .parts { display: grid; gap: 18px; }
  .part { scroll-margin-top: calc(var(--header-h) + 16px); }
  .part summary { list-style: none; display: grid; grid-template-columns: auto 1fr auto; gap: 22px; padding: 26px 28px; cursor: pointer; align-items: start; }
  .part summary::-webkit-details-marker { display: none; }
  .part-num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .part-main { display: grid; gap: 6px; min-width: 0; }
  .part-title { font-family: var(--font-head); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.015em; }
  .part-summary { color: var(--muted); font-size: 0.93rem; }
  .part-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.82rem; color: var(--faint); align-items: center; }
  .part-progress { display: block; max-width: 260px; margin-top: 4px; }
  .part-progress .progress { display: block; height: 4px; }
  .chev { font-size: 1.3rem; color: var(--faint); transition: transform .2s; line-height: 1; }
  .part[open] .chev { transform: rotate(180deg); }
  .part[open] summary { border-bottom: 1px solid var(--border); }
  .lesson-list { list-style: none; margin: 0; padding: 8px; display: grid; gap: 2px; }
  .lesson-list a { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; align-items: start; padding: 12px 14px; border-radius: 10px; text-decoration: none; }
  .lesson-list a:hover { background: var(--surface-2); }
  .li-num { color: var(--faint); font-size: 0.8rem; padding-top: 2px; }
  .li-body { display: grid; gap: 3px; min-width: 0; }
  .li-title { font-weight: 600; line-height: 1.35; }
  .li-desc { color: var(--muted); font-size: 0.86rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .li-meta { display: flex; gap: 10px; align-items: center; font-size: 0.76rem; color: var(--faint); padding-top: 3px; }
  .li-meta .diff::before { margin: 0; }
  .li-done { display: none; color: var(--ok); font-weight: 700; }
  a.done .li-done { display: inline; }
  a.done .li-title { color: var(--muted); }
  .legend { display: flex; gap: 18px; margin-top: 20px; font-size: 0.8rem; }

  .tips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tip { padding: 32px; }
  .tip .mono { color: var(--accent); font-weight: 700; font-size: 0.85rem; }
  .tip h3 { font-size: 1.12rem; margin: 10px 0 8px; }
  .tip p { margin: 0; color: var(--muted); font-size: 0.93rem; }
  .course-credit { font-size: 0.84rem; color: var(--faint); margin: 40px 0 0; line-height: 1.6; max-width: 90ch; }
  .course-credit a { color: var(--muted); }

  @media (max-width: 900px) {
    .hero { padding-top: 36px; }
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .tips { grid-template-columns: 1fr; }
    .part summary { padding: 16px; gap: 12px; }
    .part-num { width: 36px; height: 36px; font-size: 0.85rem; }
    .lesson-list a { grid-template-columns: 26px 1fr; }
    .li-meta { grid-column: 2; padding-top: 0; }
  }
</style>
