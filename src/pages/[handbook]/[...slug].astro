---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCourses, resolvePrerequisites, relatedLessons, formatMinutes, type Lesson } from '../../lib/content';
import { SOURCE, LICENSE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const courses = await getCourses();
  return [...courses.values()].flatMap((course) =>
    course.lessons.map((lesson) => ({
      params: { handbook: course.config.id, slug: lesson.url.split('/').slice(2, -1).join('/') },
      props: { courseId: course.config.id, lessonId: lesson.id },
    })),
  );
}

const { courseId, lessonId } = Astro.props;
const course = (await getCourses()).get(courseId)!;
const idx = course.lessons.findIndex((l) => l.id === lessonId);
const lesson = course.lessons[idx];
const part = course.parts.find((p) => p.folder === lesson.folder)!;
const prev: Lesson | undefined = course.lessons[idx - 1];
const next: Lesson | undefined = course.lessons[idx + 1];
const prereqs = resolvePrerequisites(course, lesson);
const related = relatedLessons(course, lesson);
const { Content, headings } = await render(lesson.entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const sourceUrl = `${SOURCE.repo}/blob/main/content/${lesson.id}.md`;
const updated = lesson.updated?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const allIds = course.lessons.map((l) => l.id).join(',');
---

<BaseLayout title={lesson.title} description={lesson.description} course={course.config.id} bodyClass="lesson-page">
  <div class="lesson-shell container">
    <!-- Course sidebar -->
    <aside class="course-nav" id="course-nav" data-course-nav aria-label={`${course.config.title} lessons`}>
      <div class="course-nav-inner">
        <a class="course-nav-title" href={`/${course.config.id}/`}>
          <span class="eyebrow">Course</span>
          <strong>{course.config.title}</strong>
        </a>
        <div class="course-nav-progress" data-progress={allIds}>
          <div class="progress"><span></span></div>
          <small class="muted" data-progress-label>{course.lessons.length} lessons</small>
        </div>
        <nav>
          {course.parts.map((p) => (
            <details open={p.folder === part.folder} class="nav-part">
              <summary>
                <span class="nav-part-label mono">{p.number !== null ? String(p.number).padStart(2, '0') : '··'}</span>
                <span class="nav-part-title">{p.title}</span>
                <span class="nav-part-count">{p.lessons.length}</span>
              </summary>
              <ol>
                {p.lessons.map((l) => (
                  <li>
                    <a href={l.url} data-lesson-id={l.id} aria-current={l.id === lesson.id ? 'page' : undefined}>
                      <span class="tick" aria-hidden="true"></span>
                      <span>{l.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Lesson -->
    <article class="lesson">
      <button class="btn btn-ghost course-nav-toggle" type="button" data-nav-toggle aria-controls="course-nav" aria-expanded="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h16"/></svg>
        Course contents
      </button>

      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/${course.config.id}/`}>{course.config.title}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${course.config.id}/#${part.slug}`}>{part.number !== null ? `Part ${part.number}: ` : ''}{part.title}</a>
      </nav>

      <header class="lesson-head">
        <span class="eyebrow">Lesson {lesson.indexInPart} of {part.lessons.length} · {part.label}</span>
        <h1>{lesson.title}</h1>
        {lesson.description && <p class="lesson-desc">{lesson.description}</p>}
        <div class="lesson-meta">
          <span class:list={['diff', `diff-${lesson.difficulty}`]}>{lesson.difficulty}</span>
          <span>{formatMinutes(lesson.minutes)} read</span>
          {lesson.diagrams > 0 && <span>{lesson.diagrams} diagram{lesson.diagrams > 1 ? 's' : ''}</span>}
          {updated && <span>Updated {updated}</span>}
          <span class="done-badge" data-lesson-id={lesson.id}>✓ Completed</span>
        </div>
        {prereqs.length > 0 && (
          <div class="prereqs">
            <span class="prereqs-label">Before this lesson</span>
            <ul>{prereqs.map((p) => <li><a href={p.url} data-lesson-id={p.id}>{p.title}</a></li>)}</ul>
          </div>
        )}
      </header>

      {toc.length > 2 && (
        <details class="toc-inline">
          <summary>On this page</summary>
          <ul>{toc.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>
      )}

      <div class="prose" data-pagefind-body data-pagefind-filter={`course:${course.config.title}`} data-pagefind-meta={`part:${part.title}`}>
        <Content />
      </div>

      <section class="lesson-end">
        <div class="card complete-card">
          <div>
            <strong>Finished reading?</strong>
            <p class="muted">Mark it complete to track your progress through the course. Progress is saved in this browser.</p>
          </div>
          <button class="btn btn-accent" type="button" data-complete={lesson.id}>
            <span class="when-todo">Mark as complete</span>
            <span class="when-done">✓ Completed · undo</span>
          </button>
        </div>

        <div class="card notes-card">
          <div class="notes-head">
            <label for="lesson-notes"><strong>My notes</strong></label>
            <span class="muted notes-status" data-notes-status>Saved in this browser</span>
          </div>
          <textarea id="lesson-notes" data-notes={lesson.id} rows="5" placeholder="Write what you learned in your own words. Explaining it back is the fastest way to find gaps."></textarea>
          <div class="notes-foot">
            <a href="/notes/">All my notes</a>
          </div>
        </div>

        {related.length > 0 && (
          <nav class="read-next" aria-label="Read next">
            <span class="eyebrow">Read next</span>
            <div class="read-next-grid">
              {related.map((l) => (
                <a class="card read-next-card" href={l.url} data-lesson-id={l.id}>
                  <strong>{l.title}</strong>
                  {l.description && <span class="read-next-desc">{l.description}</span>}
                  <small class="muted">{formatMinutes(l.minutes)} read</small>
                </a>
              ))}
            </div>
          </nav>
        )}

        <nav class="pager" aria-label="Lesson navigation">
          {prev ? (
            <a class="card pager-link" href={prev.url} rel="prev">
              <small>← Previous</small>
              <span>{prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="card pager-link next" href={next.url} rel="next">
              <small>Next →</small>
              <span>{next.title}</span>
            </a>
          ) : (
            <a class="card pager-link next" href={`/${course.config.id}/`}>
              <small>Course complete →</small>
              <span>Back to {course.config.title}</span>
            </a>
          )}
        </nav>

        <p class="credit">This lesson is adapted from <a href={sourceUrl} target="_blank" rel="noopener">“{lesson.title}”</a> in The Engineering Handbook by Handbook Academy and contributors, used under <a href={LICENSE_URL} target="_blank" rel="noopener">CC BY-SA 4.0</a>. Changes: {lesson.entry.data.rewritten ? 'rewritten in a new voice and structure, with added examples, and restyled for this site' : 'restyled and reorganized for this site'}. <a href={sourceUrl} target="_blank" rel="noopener">View original source</a>.</p>
      </section>
    </article>

    <!-- On this page -->
    {toc.length > 0 && (
      <aside class="toc" aria-label="On this page">
        <div class="toc-inner">
          <div class="toc-head">
            <span class="eyebrow">On this page</span>
            <svg class="read-ring" viewBox="0 0 36 36" width="32" height="32" role="img" aria-label="Reading progress">
              <circle cx="18" cy="18" r="15.5" pathLength="100" />
              <circle class="read-ring-value" cx="18" cy="18" r="15.5" pathLength="100" data-read-ring />
            </svg>
          </div>
          <ul>
            {toc.map((h) => (
              <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
  <div class="nav-backdrop" data-nav-backdrop></div>

  <script>
    import { refreshProgress, setDone, getDone, getNote, setNote, setLast } from '../../scripts/progress';

    const completeBtn = document.querySelector<HTMLButtonElement>('[data-complete]')!;
    const id = completeBtn.dataset.complete!;
    const course = id.split('/')[0];
    setLast(course, location.pathname);

    const sync = () => {
      const done = getDone().has(id);
      completeBtn.classList.toggle('is-done', done);
      document.body.classList.toggle('lesson-done', done);
      refreshProgress();
    };
    completeBtn.addEventListener('click', () => {
      setDone(id, !getDone().has(id));
      sync();
    });
    sync();

    // Notes
    const notes = document.querySelector<HTMLTextAreaElement>('[data-notes]')!;
    const status = document.querySelector<HTMLElement>('[data-notes-status]')!;
    notes.value = getNote(id);
    let t: number | undefined;
    notes.addEventListener('input', () => {
      status.textContent = 'Saving…';
      clearTimeout(t);
      t = window.setTimeout(() => {
        setNote(id, notes.value);
        status.textContent = 'Saved in this browser';
      }, 400);
    });

    // Mobile course navigation drawer
    const nav = document.querySelector<HTMLElement>('[data-course-nav]')!;
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
    const backdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]')!;
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      backdrop.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    const cur = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (cur) nav.scrollTop = Math.max(0, cur.offsetTop - nav.clientHeight / 2);

    // Heading anchors
    document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((h) => {
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.className = 'heading-anchor';
      a.setAttribute('aria-label', 'Link to this section');
      a.textContent = '#';
      h.appendChild(a);
    });

    // Reading progress ring
    const ring = document.querySelector<SVGCircleElement>('[data-read-ring]');
    const body = document.querySelector<HTMLElement>('.prose');
    if (ring && body) {
      const syncRing = () => {
        const { top, height } = body.getBoundingClientRect();
        const read = Math.min(1, Math.max(0, -top / Math.max(1, height - innerHeight)));
        ring.style.strokeDasharray = `${read * 100} 100`;
      };
      addEventListener('scroll', syncRing, { passive: true });
      addEventListener('resize', syncRing);
      syncRing();
    }

    // Table of contents scroll spy
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
    if (links.size) {
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              links.get(e.target.id)?.classList.add('active');
            }
          }
        },
        { rootMargin: '-80px 0px -70% 0px' },
      );
      links.forEach((_, slug) => {
        const el = document.getElementById(slug);
        if (el) obs.observe(el);
      });
    }
  </script>
</BaseLayout>

<style>
  :global(body.lesson-page .site-header .container) { width: min(1440px, 100% - 32px); }
  .lesson-shell {
    width: min(1440px, 100% - 32px);
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 250px;
    gap: 48px;
    align-items: start;
  }
  /* Sidebar */
  .course-nav { position: sticky; top: var(--header-h); height: calc(100dvh - var(--header-h)); overflow-y: auto; padding: 36px 16px 56px 0; scrollbar-width: thin; scrollbar-gutter: stable; }
  .course-nav-title { display: grid; gap: 10px; text-decoration: none; margin-bottom: 20px; }
  .course-nav-title strong { font-family: var(--font-head); font-size: 1.15rem; }
  .course-nav-progress { display: grid; gap: 10px; margin-bottom: 28px; }
  .nav-part { border-top: 1px solid var(--border); }
  .nav-part summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 15px 4px; cursor: pointer; font-weight: 600; font-size: 0.9rem; line-height: 1.4; }
  .nav-part summary::-webkit-details-marker { display: none; }
  .nav-part-label { flex: none; color: var(--accent); font-size: 0.74rem; width: 18px; }
  .nav-part-title { flex: 1; }
  .nav-part-count { font-size: 0.72rem; color: var(--faint); font-family: var(--font-mono); }
  .nav-part ol { list-style: none; margin: 2px 0 18px; padding: 0; display: grid; gap: 6px; }
  .nav-part ol a { display: flex; gap: 12px; align-items: flex-start; padding: 10px 12px 10px 8px; border-radius: 8px; text-decoration: none; color: var(--muted); font-size: 0.86rem; line-height: 1.5; }
  .nav-part ol a:hover { background: var(--surface-2); color: var(--text); }
  .nav-part ol a[aria-current='page'] { background: var(--accent-soft); color: var(--text); font-weight: 600; }
  .tick { flex: none; width: 14px; height: 14px; margin-top: 3px; border-radius: 50%; border: 1.5px solid var(--border); }
  a.done .tick { background: var(--accent); border-color: var(--accent); box-shadow: inset 0 0 0 2.5px var(--surface); }

  /* Lesson */
  .lesson { padding: 48px 0 56px; min-width: 0; width: 100%; max-width: 780px; }
  .course-nav-toggle { display: none; height: 38px; font-size: 0.88rem; margin-bottom: 18px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.86rem; color: var(--faint); margin-bottom: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .lesson-head { padding-bottom: 36px; margin-bottom: 48px; border-bottom: 1px solid var(--border); }
  .lesson-head h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); margin: 14px 0 14px; }
  .lesson-desc { font-size: 1.15rem; color: var(--muted); margin: 0 0 18px; line-height: 1.55; }
  .lesson-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-size: 0.86rem; color: var(--muted); }
  .done-badge { display: none; color: var(--ok); font-weight: 600; }
  .done-badge.done { display: inline; }
  .prereqs { margin-top: 20px; padding: 14px 16px; border-radius: var(--radius-sm); background: var(--surface); border: 1px dashed var(--border); font-size: 0.9rem; }
  .prereqs-label { font: 600 0.72rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .07em; color: var(--faint); }
  .prereqs ul { margin: 8px 0 0; padding-left: 1.2em; display: grid; gap: 4px; }
  .prereqs a { color: var(--accent); }
  .prereqs a.done::after { content: ' ✓'; color: var(--ok); }
  .toc-inline { display: none; margin-bottom: 28px; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0 16px; background: var(--surface); }
  .toc-inline summary { padding: 12px 0; font-weight: 600; cursor: pointer; }
  .toc-inline ul { margin: 0 0 14px; padding-left: 1.1em; display: grid; gap: 6px; font-size: 0.92rem; }
  .toc-inline a { color: var(--muted); }

  .lesson-end { margin-top: 80px; display: grid; gap: 28px; }
  .complete-card { display: flex; gap: 20px; align-items: center; justify-content: space-between; padding: 28px; }
  .complete-card p { margin: 4px 0 0; font-size: 0.9rem; }
  .complete-card .when-done { display: none; }
  .complete-card .btn { white-space: nowrap; flex: none; }
  .complete-card .is-done { background: var(--surface-2); color: var(--ok); border: 1px solid var(--border); }
  .complete-card .is-done .when-todo { display: none; }
  .complete-card .is-done .when-done { display: inline; }
  .notes-card { padding: 28px; display: grid; gap: 14px; }
  .notes-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .notes-status { font-size: 0.8rem; }
  .notes-card textarea { width: 100%; resize: vertical; min-height: 110px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); color: var(--text); padding: 12px 14px; font: 0.95rem/1.6 var(--font-body); }
  .notes-foot { font-size: 0.85rem; }
  .notes-foot a { color: var(--accent); }
  .read-next { display: grid; gap: 16px; margin-top: 12px; }
  .read-next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px; }
  .read-next-card { display: grid; gap: 8px; align-content: start; padding: 22px; text-decoration: none; transition: border-color .15s, transform .15s; }
  .read-next-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .read-next-card strong { font-family: var(--font-head); line-height: 1.3; }
  .read-next-desc { color: var(--muted); font-size: 0.86rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pager-link { display: grid; gap: 4px; padding: 16px 18px; text-decoration: none; transition: border-color .15s, transform .15s; }
  .pager-link:hover { border-color: var(--accent); transform: translateY(-1px); }
  .pager-link small { color: var(--faint); font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: .06em; }
  .pager-link span { font-weight: 600; line-height: 1.35; }
  .pager-link.next { text-align: right; }
  .credit { font-size: 0.82rem; color: var(--faint); line-height: 1.6; margin: 8px 0 0; }
  .credit a { color: var(--muted); }

  /* TOC */
  .toc { position: sticky; top: var(--header-h); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; padding: 48px 14px 56px 0; scrollbar-width: thin; scrollbar-gutter: stable; }
  .toc-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .read-ring { flex: none; transform: rotate(-90deg); fill: none; stroke: var(--border); stroke-width: 3; }
  .read-ring-value { stroke: var(--accent); stroke-dasharray: 0 100; stroke-linecap: round; }
  .toc ul { list-style: none; margin: 22px 0 0; padding: 0; border-left: 1px solid var(--border); counter-reset: toc; }
  .toc .toc-d2 { counter-increment: toc; }
  .toc .toc-d2 a { display: flex; gap: 10px; }
  .toc .toc-d2 a::before { content: counter(toc, decimal-leading-zero); flex: none; padding-top: 2px; font: 600 0.68rem var(--font-mono); color: var(--faint); }
  .toc a { display: block; padding: 9px 4px 9px 16px; margin-left: -1px; border-left: 2px solid transparent; text-decoration: none; color: var(--faint); font-size: 0.82rem; line-height: 1.5; }
  .toc .toc-d3 a { padding-left: 42px; font-size: 0.78rem; }
  .toc a:hover { color: var(--text); }
  .toc a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }

  .nav-backdrop { display: none; }

  @media (max-width: 1240px) {
    .lesson-shell { grid-template-columns: 260px minmax(0, 1fr); gap: 40px; }
    .toc { display: none; }
    .toc-inline { display: block; }
  }
  @media (max-width: 900px) {
    .lesson-shell { grid-template-columns: minmax(0, 1fr); }
    .lesson { justify-self: center; padding-top: 20px; }
    .course-nav-toggle { display: inline-flex; }
    .course-nav {
      position: fixed; z-index: 60; top: 0; left: 0; height: 100dvh; width: min(330px, 86vw);
      background: var(--surface); border-right: 1px solid var(--border); padding: 20px 16px 40px;
      transform: translateX(-102%); transition: transform .25s ease; box-shadow: var(--shadow);
    }
    .course-nav.open { transform: none; }
    .nav-backdrop.open { display: block; position: fixed; inset: 0; z-index: 55; background: rgb(0 0 0 / 0.35); }
    .pager { grid-template-columns: 1fr; }
    .complete-card { flex-direction: column; align-items: flex-start; }
  }
</style>
