---
import '../styles/global.css';
import { SITE, SOURCE, ML_SOURCE, LICENSE_URL } from '../lib/site';
import { HANDBOOKS } from '../lib/handbooks';

interface Props {
  title?: string;
  description?: string;
  course?: string;
  bodyClass?: string;
}
const { title, description = SITE.description, course, bodyClass } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · System Design, DSA, AI & Machine Learning`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-course={course}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d7a6f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('lwr:theme'); } catch {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/" aria-label={`${SITE.name} home`}>
          <img class="logo-mark" src="/favicon.svg" alt="" width="32" height="32" />
          <span>Engineering <span class="dim">Path</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'true' : undefined}>Home</a>
          <div class="nav-menu" data-nav-menu>
            <button class="nav-menu-btn" type="button" data-nav-menu-btn aria-expanded="false" aria-controls="courses-menu" aria-current={HANDBOOKS.some((h) => path.startsWith(`/${h.id}/`)) ? 'true' : undefined}>
              Courses
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-menu-panel" id="courses-menu">
              <a href="/#courses">All courses</a>
              {HANDBOOKS.map((h) => (
                <a href={`/${h.id}/`} aria-current={path.startsWith(`/${h.id}/`) ? 'true' : undefined}>{h.short}</a>
              ))}
            </div>
          </div>
        </nav>
        <div class="header-actions">
          <a class="search-btn" href="/search/" data-search-trigger aria-label="Search lessons">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="label">Search</span>
            <kbd>/</kbd>
          </a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav class="mobile-nav" data-mobile-nav aria-label="Mobile">
        <a href="/">Home</a>
        <span class="mobile-nav-label">Courses</span>
        <a class="mobile-nav-sub" href="/#courses">All courses</a>
        {HANDBOOKS.map((h) => <a class="mobile-nav-sub" href={`/${h.id}/`}>{h.short}</a>)}
        <a href="/search/">Search</a>
        <a href="/newsletter/">Newsletter</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="logo" href="/"><img class="logo-mark" src="/favicon.svg" alt="" width="32" height="32" /><span>Engineering <span class="dim">Path</span></span></a>
            <p style="max-width: 42ch; margin-top: 14px;">{SITE.description} Free to read, no sign-up.</p>
          </div>
          <div>
            <h4>Courses</h4>
            <ul>{HANDBOOKS.map((h) => <li><a href={`/${h.id}/`}>{h.title}</a></li>)}</ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul>
              <li><a href="/search/">Search</a></li>
              <li><a href="/newsletter/">Newsletter</a></li>
              <li><a href="/license/">License & credits</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-legal">Course content is adapted from <a href={SOURCE.repo} target="_blank" rel="noopener">The Engineering Handbook</a> by Handbook Academy and contributors, licensed under <a href={LICENSE_URL} target="_blank" rel="noopener">CC BY-SA 4.0</a>, and, for the Machine Learning course, <a href={ML_SOURCE.repo} target="_blank" rel="noopener">ML For Beginners</a> by Microsoft and contributors, under the MIT License. It has been reorganized, restyled and adapted for this site, and each adaptation is shared under the license of its source. {SITE.name} is not affiliated with or endorsed by Handbook Academy or Microsoft. <a href="/license/">Full credits</a>.</p>
      </div>
    </footer>

    <script>
      import { initReveal } from '../scripts/reveal';
      import { initDiagrams } from '../scripts/diagrams';
      import { initCodeBlocks } from '../scripts/code-blocks';

      initCodeBlocks();
      initReveal();

      const header = document.querySelector('.site-header');
      const syncHeader = () => header?.classList.toggle('is-scrolled', scrollY > 8);
      addEventListener('scroll', syncHeader, { passive: true });
      syncHeader();

      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('lwr:theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('lwr:theme', { detail: next }));
      });
      const menuBtn = document.querySelector('[data-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      menuBtn?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', String(!!open));
      });
      mobileNav?.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('a')) return;
        mobileNav.classList.remove('open');
        menuBtn?.setAttribute('aria-expanded', 'false');
      });
      const coursesMenu = document.querySelector('[data-nav-menu]');
      const coursesBtn = document.querySelector<HTMLElement>('[data-nav-menu-btn]');
      const setCoursesOpen = (open: boolean) => {
        coursesMenu?.classList.toggle('open', open);
        coursesBtn?.setAttribute('aria-expanded', String(open));
      };
      coursesBtn?.addEventListener('click', () => setCoursesOpen(!coursesMenu?.classList.contains('open')));
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!coursesMenu?.contains(target) || target.closest('a')) setCoursesOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && coursesMenu?.classList.contains('open')) {
          setCoursesOpen(false);
          coursesBtn?.focus();
        }
        const el = e.target as HTMLElement;
        if (e.key === '/' && !e.metaKey && !e.ctrlKey && !['INPUT', 'TEXTAREA'].includes(el.tagName) && !el.isContentEditable) {
          e.preventDefault();
          location.href = '/search/';
        }
      });

      initDiagrams();
    </script>
  </body>
</html>
